# Copy to .env (gitignored). Nothing here is required to run the vault locally.

# --- Vault ------------------------------------------------------------------
# Override archive autodiscovery (default: newest twitter-* dir in the repo).
# VAULT_ARCHIVE_DIR=twitter-2026-08-02-3f9340e5...

# Scopes granted to the MCP server. dms.read is omitted deliberately.
# Use '*' to grant everything.
VAULT_SCOPES=tweets.read,likes.read,graph.read,media.read,analytics.read

# Mirror every tool call to stderr as well as audit.log.
# VAULT_AUDIT_ECHO=1

# Derive the vault key from a passphrase instead of the macOS Keychain.
# Required on non-macOS or headless machines. Must be high-entropy: the salt is
# fixed so that the same passphrase always yields the same key.
# VAULT_PASSPHRASE=

# --- Moca -------------------------------------------------------------------
# Used by web/companion.html (browser only — AIR Kit cannot run in Node).
MOCA_PARTNER_ID=3dd91077-c6db-4cb6-9f8d-1d603b85f8ee

# Testnet signer for on-chain Merkle-root anchoring. TESTNET KEYS ONLY.
# Without it, `vault seal` records the root locally with no on-chain proof.
# MOCA_ANCHOR_PRIVATE_KEY=0x...

# --- Credential-gated HTTP transport ----------------------------------------
# Only for `vault serve --http`. The stdio server ignores all of this and takes
# its scopes from VAULT_SCOPES. The HTTP server refuses to start without an
# issuer: it is credential-gated by design and never runs open.
#
# The issuer's origin, which is both the expected `iss` and the place its keys
# are fetched from ($VAULT_ISSUER_URL/.well-known/jwt-vc-issuer).
# VAULT_ISSUER_URL=https://issuer.example.com
# VAULT_ISSUER_VCT=https://adam.id/vct/adam-id-access/v1
# VAULT_ISSUER_AUDIENCE=adam-id
#
# Development only: trust a local JWKS instead of fetching from the issuer.
# Pair with `npm run mint-test-credential`.
# VAULT_ISSUER_JWKS_FILE=.dev/issuer-jwks.json
#
# Override the JWKS fetch URL without changing the expected `iss`. Useful when
# the vault and issuer run on the same machine: fetch keys from the local
# issuer service while still requiring credentials to be issued by the public
# origin. The metadata document's `issuer` claim must still match VAULT_ISSUER_URL.
# VAULT_ISSUER_JWKS_URL=http://127.0.0.1:3000/.well-known/jwt-vc-issuer
#
# Revocation is checked against the issuer and FAILS CLOSED — an unreachable
# issuer denies rather than admits. Set to 1 only for offline testing.
# VAULT_SKIP_REVOCATION_CHECK=1
# VAULT_REVOCATION_URL=            # defaults to VAULT_ISSUER_URL
#
# A successful check is cached this long (default 60s). Revoking at the issuer
# therefore takes up to this long to stop a NEW session from a credential just
# used, and does not affect sessions already open. `vault revoke` is the fast
# path — local, instant, and it tears down live sessions.
# VAULT_REVOCATION_TTL_MS=60000
#
# Bind address. Loopback on purpose: reaching this from outside should be a
# deliberate act (a Cloudflare Tunnel), not a side effect of starting it.
# VAULT_HTTP_HOST=127.0.0.1
# VAULT_HTTP_PORT=8787
# Extra Host values to accept — add your tunnel hostname here or every tunnelled
# request is rejected with forbidden_host. This is the step that costs an hour
# when forgotten: the guard runs before authentication, so the failure looks
# like a denial with no credential detail. See ops/TUNNEL.md.
# VAULT_HTTP_ALLOWED_HOSTS=vault.minds.monster

# MCSP storage endpoint. The backend is not implemented: airkit@1.10.0 ships no
# storage client, so the API contract is still unknown. See src/storage/mcsp.ts.
# MCSP_ENDPOINT=

# --- Admin provisioning endpoints (optional) --------------------------------
# Enables `POST /admin/issue-credential` and `POST /admin/revoke` on the HTTP
# server. These let an external system (e.g. minds-monster/worker) mint an
# adam-id credential and grant a Mind access without shell access to the vault.
# VAULT_ADMIN_API_KEY=                # protects /admin/*
# VAULT_ISSUER_ADMIN_KEY=             # issuer's ADMIN_API_KEY for /admin/issue-sd-jwt
# VAULT_ISSUER_ADMIN_ORIGIN=http://127.0.0.1:3000  # dev loopback; in prod use the reachable issuer origin
# CF_ACCESS_CLIENT_ID=                # only when VAULT_ISSUER_ADMIN_ORIGIN is behind Cloudflare Access
# CF_ACCESS_CLIENT_SECRET=

# --- Mind playbook installer ------------------------------------------------
# Used by `npm run install-vault-playbook` to push the vault contract to a Mind.
# These are secrets: prefer --credential-file/--cf-*-file flags or a separate
# env-file over pasting them here.
# MINDS_BUILDER_API_KEY=
# ADAM_ID_VC=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
